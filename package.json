{
  "name": "daos",
  "version": "0.1.0",
  "private": true,
  "description": "DAOS multi-tenant private capital market platform (sub-project 1: foundation + tenant/identity)",
  "scripts": {
    "build": "nest build api-gateway && nest build tenant-identity && nest build investor-management && nest build asset-origination && nest build opportunity-engineering && nest build deal-studio && nest build legal-entity-studio && nest build product-design-studio && nest build issuance-studio && nest build document-management && nest build cap-table && nest build distribution && nest build marketplace && nest build settlement && nest build tenant-organization && nest build waterfall-engine && nest build pricing-valuation",
    "start:gateway": "nest start api-gateway",
    "start:identity": "nest start tenant-identity",
    "start:investor": "nest start investor-management",
    "start:asset": "nest start asset-origination",
    "start:opportunity": "nest start opportunity-engineering",
    "start:deal": "nest start deal-studio",
    "start:entity": "nest start legal-entity-studio",
    "start:product": "nest start product-design-studio",
    "start:issuance": "nest start issuance-studio",
    "start:document": "nest start document-management",
    "start:cap-table": "nest start cap-table",
    "start:distribution": "nest start distribution",
    "start:marketplace": "nest start marketplace",
    "start:settlement": "nest start settlement",
    "start:waterfall": "nest start waterfall-engine",
    "start:pricing": "nest start pricing-valuation",
    "start:dev": "concurrently -n identity,investor,gateway -c blue,green,yellow \"nest start tenant-identity --watch\" \"nest start investor-management --watch\" \"nest start api-gateway --watch\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "lint": "eslint \"{apps,libs}/**/*.ts\"",
    "format": "prettier --write \"{apps,libs}/**/*.ts\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/cqrs": "^11.0.0",
    "@nestjs/microservices": "^11.2.3",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/typeorm": "^12.0.1",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^15.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "webpack": "^5.94.0",
    "webpack-node-externals": "^3.0.0"
  }
}
