# ==================================================
# DAOS Environment Variables
# ==================================================

# ─── Database (PostgreSQL) ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=daos
DB_PASSWORD=daos_dev_password
DB_NAME=daos
DB_SYNC=false
DB_LOGGING=false

# ─── Redis ───────────────────────────────────────────────────────────────
REDIS_URL=redis://:daos_redis_password@localhost:6379
USE_REDIS=false

# ─── Kafka (for production) ──────────────────────────────────────────────
# KAFKA_BROKERS=localhost:9092
# SCHEMA_REGISTRY_URL=http://localhost:8081

# ─── Identity Service ────────────────────────────────────────────────────
IDENTITY_PORT=3001
JWT_SECRET=dev-secret-change-me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
PLATFORM_ADMIN_EMAIL=admin@platform.local
PLATFORM_ADMIN_PASSWORD=platform-admin-password

# ─── Gateway ─────────────────────────────────────────────────────────────
GATEWAY_PORT=3000
IDENTITY_URL=http://localhost:3001
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_MS=60000

# ─── New Services (ports) ────────────────────────────────────────────────
INVESTOR_URL=http://localhost:3002
ASSET_URL=http://localhost:3003
OPPORTUNITY_URL=http://localhost:3004
DEAL_URL=http://localhost:3005
ENTITY_URL=http://localhost:3006
PRODUCT_URL=http://localhost:3007
ISSUANCE_URL=http://localhost:3008
DISTRIBUTION_URL=http://localhost:3009
MARKETPLACE_URL=http://localhost:3010
WATERFALL_URL=http://localhost:3011
SETTLEMENT_URL=http://localhost:3012
COMPLIANCE_URL=http://localhost:3013
REPORTING_URL=http://localhost:3014
DOCUMENT_URL=http://localhost:3015
NOTIFICATION_URL=http://localhost:3016
WALLET_URL=http://localhost:3017
PRICING_URL=http://localhost:3018
RISK_URL=http://localhost:3019
GOVERNANCE_URL=http://localhost:3020

# ─── External Provider Keys ( stubs — configure in production ) ──────────
# KYC Provider (Sumsub/Onfido/Jumio)
# KYC_PROVIDER_API_KEY=your_api_key
# KYC_PROVIDER_API_SECRET=your_api_secret

# E-Signature (DocuSign/Adobe Sign)
# ESIGN_API_KEY=your_api_key
# ESIGN_API_SECRET=your_api_secret

# Payment Gateway (Stripe/Braintree/Crypto)
# PAYMENT_GATEWAY_API_KEY=your_api_key

# Blockchain Node
# ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_KEY
# POLYGON_RPC_URL=https://polygon-rpc.com
# AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc

# External APIs
# BLOOMBERG_API_KEY=your_api_key
# FIREBLOCKS_API_KEY=your_api_key
