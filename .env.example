# ==================================================
# DAOS Environment Variables
# ==================================================

# ─── Database (PostgreSQL – app data) ──────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USER=daos
DB_PASSWORD=daos_dev_password
DB_NAME=daos
DB_SYNC=false
DB_LOGGING=false

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://:daos_redis_password@redis:6379
USE_REDIS=false

# ─── Kafka ──────────────────────────────────────────────────────────────────
# KAFKA_BROKERS=kafka:9093
# SCHEMA_REGISTRY_URL=http://schema-registry:8081

# ─── Identity Service ──────────────────────────────────────────────────────
IDENTITY_PORT=3001
JWT_SECRET=dev-secret-change-me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
PLATFORM_ADMIN_EMAIL=admin@platform.local
PLATFORM_ADMIN_PASSWORD=platform-admin-password

# ─── Kong Gateway (DB-backed) ──────────────────────────────────────────────
KONG_PG_HOST=kong-db
KONG_PG_PORT=5432
KONG_PG_USER=kong
KONG_PG_PASSWORD=kong_dev_password
KONG_PG_DATABASE=kong

# ─── Kuma Service Mesh ────────────────────────────────────────────────────
KUMA_CP_URL=http://kuma-cp:5680
KUMA_MESH=default

# ─── Microservice Ports (for sidecar inbound) ─────────────────────────────
# Apps bind to 127.0.0.1 via HOST=127.0.0.1; Envoy sidecar exposes :9000.
# Inter-service calls go through local Envoy outbound ports (not yet wired).
IDENTITY_URL=http://tenant-identity:9000
INVESTOR_URL=http://investor-management:9000
ASSET_URL=http://asset-origination:9000
OPPORTUNITY_URL=http://opportunity-engineering:9000
DEAL_URL=http://deal-studio:9000
ENTITY_URL=http://legal-entity-studio:9000
PRODUCT_URL=http://product-design-studio:9000
ISSUANCE_URL=http://issuance-studio:9000
DISTRIBUTION_URL=http://distribution:9000
MARKETPLACE_URL=http://marketplace:9000
WATERFALL_URL=http://waterfall-engine:9000
SETTLEMENT_URL=http://settlement:9000
COMPLIANCE_URL=http://compliance:9000
REPORTING_URL=http://reporting:9000
DOCUMENT_URL=http://document-management:9000
NOTIFICATION_URL=http://notification:9000
WALLET_URL=http://wallet-custody:9000
CAP_TABLE_URL=http://wallet-custody:9001
PRICING_URL=http://pricing-valuation:9000
RISK_URL=http://risk-management:9000
GOVERNANCE_URL=http://governance:9000

# ─── External Provider Keys (stubs — configure in production) ──────────────
# KYC Provider (Sumsub/Onfido/Jumio)
# KYC_PROVIDER_API_KEY=your_api_key
# KYC_PROVIDER_API_SECRET=your_api_secret

# E-Signature (DocuSign/Adobe Sign)
# ESIGN_API_KEY=your_api_key
# ESIGN_API_SECRET=your_api_secret

# Payment Gateway (Stripe/Braintree/Crypto)
# PAYMENT_GATEWAY_API_KEY=your_api_key

# Blockchain Node
# ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_KEY
# POLYGON_RPC_URL=https://polygon-rpc.com
# AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc

# External APIs
# BLOOMBERG_API_KEY=your_api_key
# FIREBLOCKS_API_KEY=your_api_key
